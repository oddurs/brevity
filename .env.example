# ---------------------------------------------------------------------------
# brevity
# Lives at ~/.config/brevity/.env  (create it with: brevity --init)
# Real environment variables always beat anything in this file.
# ---------------------------------------------------------------------------

# --- Which backend -----------------------------------------------------------
# anthropic | openai | openrouter | google | groq | deepseek | mistral |
# together | ollama | lmstudio | llamacpp | vllm | openai-compat
BREVITY_PROVIDER=anthropic

# Anthropic (default provider). Model defaults to claude-opus-5.
ANTHROPIC_API_KEY=
# BREVITY_MODEL=claude-opus-5          # or claude-sonnet-5, claude-haiku-4-5
# BREVITY_EFFORT=low                   # low|medium|high|xhigh|max - Anthropic only,
                                       # ignored by every other provider.
                                       # Defaults to low (fast, plenty for summaries).
                                       # Unset it for pre-4.6 models, which reject it.

# --- Other hosted providers --------------------------------------------------
# Set BREVITY_PROVIDER above to one of these, add its key, and set BREVITY_MODEL.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=
#
# BREVITY_API_KEY=                     # generic override, wins over the ones above
#
# Example - OpenRouter (one key reaches every model, so it is the easiest
# place to try a few before settling). The model is a full `vendor/model` slug;
# list them with:
#   curl -s https://openrouter.ai/api/v1/models | jq -r '.data[].id'
#
#   BREVITY_PROVIDER=openrouter
#   OPENROUTER_API_KEY=sk-or-v1-...
#   BREVITY_MODEL=google/gemini-3.1-flash-lite
#
# Careful: the key lines above are adjacent. Uncommenting the wrong one gives
# you "no API key for openrouter" while a key sits right there.
#
# Example - Gemini:
#   BREVITY_PROVIDER=google
#   GEMINI_API_KEY=...
#   BREVITY_MODEL=gemini-2.5-flash

# --- Local models ------------------------------------------------------------
# Any OpenAI-compatible server works. No API key needed.
#
# Ollama:       BREVITY_PROVIDER=ollama     BREVITY_MODEL=llama3.2
# LM Studio:    BREVITY_PROVIDER=lmstudio   BREVITY_MODEL=<name shown in the app>
# llama.cpp:    BREVITY_PROVIDER=llamacpp   BREVITY_MODEL=<whatever it serves>
# vLLM:         BREVITY_PROVIDER=vllm       BREVITY_MODEL=<served model id>
#
# Anything else that speaks /chat/completions:
#   BREVITY_PROVIDER=openai-compat
#   BREVITY_BASE_URL=http://192.168.1.50:8080/v1
#   BREVITY_MODEL=my-model
#
# BREVITY_BASE_URL=                    # also overrides the endpoint of any provider
                                       # above (proxies, gateways, self-hosted)

# --- The prompt --------------------------------------------------------------
# {text} is the clipboard contents, {max_words} is BREVITY_MAX_WORDS.
# Leave both unset to use the built-in prompt.
#
# BREVITY_MAX_WORDS=120                # a request in the prompt, not a cap - dense
                                       # input will overrun it
# BREVITY_SYSTEM_PROMPT="You compress text. Reply with the summary only - no preamble, no labels, no code fences. Keep names, numbers, dates, decisions and URLs. Stay under {max_words} words."
# BREVITY_PROMPT="Summarize the text between the markers.\n\n<<<TEXT\n{text}\nTEXT>>>"

# --- Named styles ------------------------------------------------------------
# `brevity --style bullets` uses BREVITY_PROMPT_BULLETS (and, if set,
# BREVITY_SYSTEM_PROMPT_BULLETS). Any name works - uppercase it, replace - with _.
#
# BREVITY_PROMPT_BULLETS="Rewrite the text below as at most 5 terse bullets, one line each. Output only the bullets.\n\n{text}"
# BREVITY_PROMPT_TLDR="Give a single {max_words}-word sentence capturing the point of this text. Output only that sentence.\n\n{text}"
# BREVITY_PROMPT_ACTIONS="List only the concrete action items, owners and deadlines in this text, one per line. If there are none, reply 'no action items'.\n\n{text}"
# BREVITY_PROMPT_EN="Summarize the text below in English, under {max_words} words. Output only the summary.\n\n{text}"
#
# BREVITY_STYLE=                       # make one of them the default

# --- Limits ------------------------------------------------------------------
# BREVITY_MAX_TOKENS=1024              # hard ceiling on the response. Reasoning
                                       # models spend their thinking tokens from
                                       # this budget and can exhaust it before
                                       # writing anything - give those several
                                       # thousand, or pick a model that answers
                                       # directly. Not the way to control length:
                                       # use BREVITY_MAX_WORDS, which asks the
                                       # model rather than truncating it.
# BREVITY_TIMEOUT_SECS=90
# BREVITY_MIN_INPUT_CHARS=0            # below this, refuse instead of summarizing
# BREVITY_MAX_INPUT_CHARS=200000       # above this, refuse instead of truncating
# BREVITY_TEMPERATURE=                 # leave unset: the Claude 5 family rejects it
# BREVITY_MAX_TOKENS_FIELD=auto        # auto|max_tokens|max_completion_tokens

# --- Feedback ----------------------------------------------------------------
# BREVITY_SOUND=true
# BREVITY_SOUND_VOLUME=0.5             # 0.0-1.0, applies to the built-in chime
# BREVITY_SOUND_FILE=                  # your own success sound. On macOS, anything
                                       # in /System/Library/Sounds works, e.g.
                                       # /System/Library/Sounds/Glass.aiff
# BREVITY_SOUND_ERROR_FILE=            # your own failure sound
# BREVITY_SOUND_CMD=                   # custom player, e.g. "paplay --volume=30000 {}"
# BREVITY_NOTIFY=errors                # off|errors|always - desktop notifications
# BREVITY_HISTORY=true                 # keep the replaced text for `brevity --restore`

# --- Misc --------------------------------------------------------------------
# BREVITY_EXTRA_HEADERS="X-Key: value; X-Other: value"
# BREVITY_OPENROUTER_TITLE=Brevity
